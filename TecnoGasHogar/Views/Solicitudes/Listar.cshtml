@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<h1>Solicitudes de Servicio Registradas</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Registrar nueva solicitud</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Distrito</th>
            <th>Tipo de Servicio</th>
            <th>Descripción</th>
            <th>Fecha de Registro</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cliente</td>
                <td>@item.Telefono</td>
                <td>@item.Distrito</td>
                <td>@item.TipoServicio</td>
                <td>@item.Descripcion</td>
                <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>